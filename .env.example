# Admin
ADMIN_EMAIL_DOMAIN=example.com
NEXT_PUBLIC_ADMIN_EMAIL_DOMAIN=example.com

# Analytics (optional)
NEXT_PUBLIC_GTM_ID=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Privacy
IP_SALT=change-this-to-a-random-string
